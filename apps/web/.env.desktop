# Build do app desktop (`vite build --mode desktop`): a API fica no domínio de produção.
# Para apontar para outro backend: VITE_API_BASE_URL=https://outro.exemplo pnpm --filter @spook/web build:desktop
VITE_API_BASE_URL=https://spook.dottadigital.com

# Login pelo navegador no desktop (deep link spook://, plugin tauri-plugin-deep-link no Rust). Só neste modo: o
# build web (`pnpm build`) não lê este arquivo e mantém a capability desligada.
VITE_DESKTOP_BROWSER_LOGIN=true
