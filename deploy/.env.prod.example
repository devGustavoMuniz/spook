# Modelo do .env de produção. NÃO coloque valores reais aqui: o arquivo real é escrito no servidor
# (/srv/spook/prod/.env, permissão 600) pelo comando `write-env` do CI a partir dos GitHub Secrets.
# Use apenas caracteres [A-Za-z0-9] nos segredos (ex.: `openssl rand -hex 32`): eles entram em URLs.

SPOOK_IMAGE=ghcr.io/<dono-em-minusculas>/spook:<tag>   # escrito pelo deploy.sh

POSTGRES_USER=spook
POSTGRES_PASSWORD=
POSTGRES_DB=spook

# Garage (S3). Endpoint PÚBLICO: as URLs pré-assinadas são usadas pelo navegador.
GARAGE_RPC_SECRET=                 # openssl rand -hex 32
GARAGE_CAPACITY=50GB
S3_ENDPOINT=https://spook-files.dottadigital.com
S3_REGION=garage
S3_BUCKET=spook
S3_ACCESS_KEY_ID=                  # "GK" + 24 caracteres hex:  echo "GK$(openssl rand -hex 12)"
S3_SECRET_ACCESS_KEY=              # openssl rand -hex 32
S3_CORS_ORIGINS=https://spook.dottadigital.com

LIVEKIT_API_KEY=                   # ex.: spook; só [A-Za-z0-9_-]. O deploy.sh o copia para o webhook do LiveKit (livekit.prod.yaml)
LIVEKIT_API_SECRET=                # openssl rand -hex 32
LIVEKIT_NODE_IP=187.127.26.46

CLOUDFLARE_TUNNEL_TOKEN=
