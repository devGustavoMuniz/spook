{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-desktop",
      "!**/target",
      "!apps/desktop/src-tauri/gen",
      "!**/node_modules",
      "!**/.turbo",
      "!packages/brand/assets",
      "!server",
      "!apps/web/src/styles.css",
      "!bench/results/raw",
      "!packages/shared/fixtures"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useUniqueElementIds": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
